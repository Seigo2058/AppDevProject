# ファイルの無視に関する詳細は https://help.github.com/articles/ignoring-files/ を参照してください。

# 依存関係
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# テスト
/coverage

# next.js
/.next/
/out/

# 本番環境
/build

# その他
.DS_Store
*.pem

# デバッグ
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 環境変数ファイル（必要に応じてコミットに含めることができます）
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
